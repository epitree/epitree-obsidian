{
  "name": "epitree-obsidian",
  "version": "0.1.0",
  "description": "Send your Obsidian notes to Epitree, where they become words with spaced-repetition reviews.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "plugin",
    "spaced repetition",
    "vocabulary"
  ],
  "author": "Teqard Labs Private Limited",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
